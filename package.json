{
  "name": "rame-code",
  "displayName": "RAME Code",
  "description": "Experimental coding missions powered by Muse with explicit verification boundaries.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Antoni Caimari Caldés",
  "publisher": "caimari",
  "repository": {
    "type": "git",
    "url": "https://github.com/caimari/rame-code.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:rameCode.setMetaApiKey",
    "onCommand:rameCode.startMission"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rameCode.setMetaApiKey",
        "title": "RAME Code: Set Meta API Key"
      },
      {
        "command": "rameCode.startMission",
        "title": "RAME Code: Start Mission"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "check": "npm run test",
    "package": "npm run check && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "3.7.1",
    "typescript": "^5.7.2"
  }
}
