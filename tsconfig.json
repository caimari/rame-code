{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "out",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": [
    "src/panel.ts",
    "src/panelHtml.ts",
    "src/chatsProvider.ts",
    "src/settingsProvider.ts",
    "src/chatsHtml.ts",
    "src/settingsHtml.ts"
  ]
}
